{
  "$id": "SITE_REACCEPTANCE_AUTHORIZATION_CONSUMPTION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schemaVersion", "producer", "reservationDigest", "transactionId",
    "preManifestSha256", "postManifestSha256", "committedSequence", "acceptanceRevision",
    "committedObjectDigests", "consumedAtMs", "consumptionDigest"
  ],
  "properties": {
    "kind": { "const": "SITE_REACCEPTANCE_AUTHORIZATION_CONSUMPTION" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "SITE_ACCEPTANCE_CONTRACT" },
    "reservationDigest": { "type": "string", "format": "sha256" },
    "transactionId": { "type": "string", "pattern": "^site-remediation-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "preManifestSha256": { "type": "string", "format": "sha256" },
    "postManifestSha256": { "type": "string", "format": "sha256" },
    "committedSequence": { "type": "integer", "minimum": 1 },
    "acceptanceRevision": { "type": "string", "format": "sha256" },
    "committedObjectDigests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "format": "sha256" }
    },
    "consumedAtMs": { "type": "integer", "minimum": 0 },
    "consumptionDigest": { "type": "string", "format": "sha256" }
  }
}
