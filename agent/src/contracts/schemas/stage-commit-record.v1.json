{
  "$id": "STAGE_COMMIT_RECORD_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "producer", "mode", "runId", "stageId", "attemptId", "contextDigest", "schemaBundleDigest", "sequence", "previous", "candidateDigest", "workerStop", "objects", "requestScope", "state", "nextAction", "errors", "events", "commitDigest"],
  "properties": {
    "kind": { "const": "STAGE_COMMIT_RECORD" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "STAGE_COMMIT_STORE" },
    "mode": { "const": "SHADOW" },
    "runId": { "type": "string", "minLength": 1 },
    "stageId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "integer", "minimum": 1 },
    "contextDigest": { "type": "string", "format": "sha256" },
    "schemaBundleDigest": { "type": "string", "format": "sha256" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previous": { "type": "object", "additionalProperties": false, "required": ["sequence", "commitDigest"], "properties": { "sequence": { "type": "integer", "minimum": 0 }, "commitDigest": { "type": ["string", "null"], "format": "sha256" } } },
    "candidateDigest": { "type": "string", "format": "sha256" },
    "workerStop": { "type": "object", "additionalProperties": false, "required": ["phase", "reason"], "properties": { "phase": { "const": "STOPPED" }, "reason": { "enum": ["SUCCEEDED", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "CANCELLED"] } } },
    "objects": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["role", "contractKind", "schemaVersion", "path", "sha256", "byteLength"], "properties": { "role": { "type": "string", "minLength": 1 }, "contractKind": { "type": "string", "minLength": 1 }, "schemaVersion": { "type": "integer", "minimum": 1 }, "path": { "type": "string", "format": "relative-posix-path" }, "sha256": { "type": "string", "format": "sha256" }, "byteLength": { "type": "integer", "minimum": 0 } } } },
    "requestScope": { "type": "object" },
    "state": { "type": "object" },
    "nextAction": { "type": "string", "minLength": 1 },
    "errors": { "type": "array", "items": { "type": "object" } },
    "events": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "commitDigest": { "type": "string", "format": "sha256" }
  }
}
