{
  "$id": "TRANSACTION_OUTCOME_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "producer", "operationId", "status", "intentDigest", "consumptionDigest", "commitDigest", "recordedAtMs", "outcomeDigest"],
  "properties": {
    "kind": { "const": "TRANSACTION_OUTCOME" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "V2_TRANSACTION_COORDINATOR" },
    "operationId": { "type": "string", "pattern": "^op-[a-f0-9]{32}$" },
    "status": { "enum": ["COMMITTED", "RECONCILIATION_REQUIRED", "ABORTED_BEFORE_CONSUMPTION"] },
    "intentDigest": { "type": "string", "format": "sha256" },
    "consumptionDigest": { "type": ["string", "null"], "format": "sha256" },
    "commitDigest": { "type": ["string", "null"], "format": "sha256" },
    "recordedAtMs": { "type": "integer", "minimum": 0 },
    "outcomeDigest": { "type": "string", "format": "sha256" }
  }
}
