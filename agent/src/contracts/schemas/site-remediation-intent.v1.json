{
  "$id": "SITE_REMEDIATION_INTENT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schemaVersion", "producer", "policyVersion", "runId", "transactionId",
    "previewId", "previewDigest", "authorizationDigest", "expectedManifestSequence",
    "expectedManifestSha256", "postManifestSha256", "committedSequence",
    "acceptanceRevision", "committedObjectDigests", "createdAtMs", "intentDigest"
  ],
  "properties": {
    "kind": { "const": "SITE_REMEDIATION_INTENT" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "SITE_REMEDIATION_TRANSACTION" },
    "policyVersion": { "const": "site-remediation-transaction-v1" },
    "runId": { "type": "string", "minLength": 1 },
    "transactionId": { "type": "string", "pattern": "^site-remediation-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "previewId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "previewDigest": { "type": "string", "format": "sha256" },
    "authorizationDigest": { "type": "string", "format": "sha256" },
    "expectedManifestSequence": { "type": "integer", "minimum": 0 },
    "expectedManifestSha256": { "type": "string", "format": "sha256" },
    "postManifestSha256": { "type": "string", "format": "sha256" },
    "committedSequence": { "type": "integer", "minimum": 1 },
    "acceptanceRevision": { "type": "string", "format": "sha256" },
    "committedObjectDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "sha256" } },
    "createdAtMs": { "type": "integer", "minimum": 0 },
    "intentDigest": { "type": "string", "format": "sha256" }
  }
}
