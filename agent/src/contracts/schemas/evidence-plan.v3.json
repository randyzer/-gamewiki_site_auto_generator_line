{
  "$id": "EVIDENCE_PLAN_V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "producer", "trustLevel", "evidenceMode", "namespace", "runId", "stageId", "attemptId", "contextDigest", "recoveryDigest", "policyVersion", "planDigest", "serviceDecisions", "tasks"],
  "properties": {
    "kind": { "const": "EVIDENCE_PLAN" },
    "schemaVersion": { "const": 3 },
    "producer": { "const": "HOST_PLAN_BUILDER" },
    "trustLevel": { "const": "T1" },
    "evidenceMode": { "enum": ["SIMULATED", "PRODUCTION"] },
    "namespace": { "type": "string", "format": "relative-posix-path" },
    "runId": { "type": "string", "minLength": 1 },
    "stageId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "integer", "minimum": 1 },
    "contextDigest": { "type": "string", "format": "sha256" },
    "recoveryDigest": { "type": "string", "format": "sha256" },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "planDigest": { "type": "string", "format": "sha256" },
    "serviceDecisions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["service", "decision"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["ACTIVE", "PAUSED", "RESUME_APPROVED"] }
        }
      }
    },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["taskId", "keyword", "gapId", "tool", "target", "sourceTypes", "budgetUnits", "criteria"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^task-[a-f0-9]{64}$" },
          "keyword": { "type": "string", "minLength": 1 },
          "gapId": { "type": "string", "pattern": "^gap-[a-f0-9]{24}$" },
          "tool": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "sourceTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "budgetUnits": { "type": "integer", "minimum": 1 },
          "criteria": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["criterionId", "statement", "requiresBody", "requiresCurrentAccess", "maxAgeMs"],
              "properties": {
                "criterionId": { "type": "string", "pattern": "^criterion-[a-f0-9]{24}$" },
                "statement": { "type": "string", "minLength": 1 },
                "requiresBody": { "type": "boolean" },
                "requiresCurrentAccess": { "type": "boolean" },
                "maxAgeMs": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
