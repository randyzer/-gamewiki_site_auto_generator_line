{
  "$id": "SITE_REACCEPTANCE_AUTHORIZATION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schemaVersion", "producer", "policyVersion", "runId", "previewId",
    "previewSnapshotSha256", "manifestSequence", "manifestSha256", "mode",
    "lineageDigest", "oldProjectDigest", "newProjectDigest", "baselineDigest",
    "remediationScopeDigest", "publicationEvidenceDigest", "attestationDigest",
    "acceptanceRevision", "operatorSummarySha256", "transactionId", "authorizationDigest"
  ],
  "properties": {
    "kind": { "const": "SITE_REACCEPTANCE_AUTHORIZATION" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "SITE_ACCEPTANCE_CONTRACT" },
    "policyVersion": { "const": "site-acceptance-v1" },
    "runId": { "type": "string", "minLength": 1 },
    "previewId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "previewSnapshotSha256": { "type": "string", "format": "sha256" },
    "manifestSequence": { "type": "integer", "minimum": 0 },
    "manifestSha256": { "type": "string", "format": "sha256" },
    "mode": { "enum": ["EXACT_REMEDIATION", "LEGACY_CURRENT_BASELINE"] },
    "lineageDigest": { "type": "string", "format": "sha256" },
    "oldProjectDigest": { "type": "string", "format": "sha256" },
    "newProjectDigest": { "type": "string", "format": "sha256" },
    "baselineDigest": { "type": "string", "format": "sha256" },
    "remediationScopeDigest": { "type": "string", "format": "sha256" },
    "publicationEvidenceDigest": { "type": "string", "format": "sha256" },
    "attestationDigest": { "type": "string", "format": "sha256" },
    "acceptanceRevision": { "type": "string", "format": "sha256" },
    "operatorSummarySha256": { "type": "string", "format": "sha256" },
    "transactionId": { "type": "string", "pattern": "^site-remediation-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "authorizationDigest": { "type": "string", "format": "sha256" }
  }
}
