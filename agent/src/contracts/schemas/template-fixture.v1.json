{
  "$id": "TEMPLATE_FIXTURE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "producer", "classification", "canonicalStageId", "mappingVersion", "sourceVerified", "copyExecuted", "templateLockAuthoritative", "repository", "copyManifest", "residueScan", "destination", "templateTreeDigest"],
  "properties": {
    "kind": { "const": "TEMPLATE_FIXTURE" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "P5_D_OFFLINE_FIXTURE" },
    "classification": { "const": "OFFLINE_STUB" },
    "canonicalStageId": { "const": "template-selection" },
    "mappingVersion": { "const": "stage-identity-v1" },
    "sourceVerified": { "const": false },
    "copyExecuted": { "const": false },
    "templateLockAuthoritative": { "const": false },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "ref", "commit", "subtree"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "subtree": { "type": "string", "minLength": 1 }
      }
    },
    "copyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universeComplete", "files"],
      "properties": {
        "universeComplete": { "const": true },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "format": "sha256" }
            }
          }
        }
      }
    },
    "residueScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedTokens", "matches"],
      "properties": {
        "checkedTokens": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "path"],
            "properties": {
              "token": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootRelativePath", "relativePath", "empty", "symlink"],
      "properties": {
        "rootRelativePath": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "empty": { "const": true },
        "symlink": { "const": false }
      }
    },
    "templateTreeDigest": { "type": "string", "format": "sha256" }
  }
}
