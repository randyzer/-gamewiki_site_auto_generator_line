        "content-integration", "ui-ux-audit", "prelaunch-acceptance",
        "deployment-plan"
      ]
    },
    "mappingVersion": { "const": "stage-identity-v1" },
    "gateObservationScope": { "const": "OFFLINE_SIMULATED" },
    "currentGate": { "enum": ["legacy", "shadow", "v2"] },
    "proposedGate": { "enum": ["legacy", "shadow", "v2"] },
    "actualGateBefore": { "enum": ["legacy", "shadow", "v2"] },
    "actualGateAfter": { "enum": ["legacy", "shadow", "v2"] },
    "decision": { "enum": ["PROPOSE_ONLY", "HOLD", "BLOCKED"] },
    "evidenceDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "sha256" }
    },
    "missingEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
