{
  "$id": "CURRENT_SITE_BASELINE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schemaVersion", "producer", "baselineKind", "historicalEquivalence",
    "digestPolicyVersion", "projectPath", "files", "inventoryDigest", "projectDigest",
    "routes", "routeInventoryDigest", "protectedInputs", "protectedInputsDigest",
    "historicalEvidenceGaps", "baselineDigest"
  ],
  "properties": {
    "kind": { "const": "CURRENT_SITE_BASELINE" },
    "schemaVersion": { "const": 1 },
    "producer": { "const": "SITE_ACCEPTANCE_CONTRACT" },
    "baselineKind": { "enum": ["VERIFIED_HISTORICAL_BASELINE", "REACCEPTED_CURRENT_BASELINE"] },
    "historicalEquivalence": { "type": "boolean" },
    "digestPolicyVersion": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string", "pattern": "^/" },
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode", "byteLength", "sha256"],
        "properties": {
          "path": { "type": "string", "format": "relative-posix-path" },
          "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "format": "sha256" }
        }
      }
    },
    "inventoryDigest": { "type": "string", "format": "sha256" },
    "projectDigest": { "type": "string", "format": "sha256" },
    "routes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/" }
    },
    "routeInventoryDigest": { "type": "string", "format": "sha256" },
    "protectedInputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode", "byteLength", "sha256"],
        "properties": {
          "path": { "type": "string", "format": "relative-posix-path" },
          "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "format": "sha256" }
        }
      }
    },
    "protectedInputsDigest": { "type": "string", "format": "sha256" },
    "historicalEvidenceGaps": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "baselineDigest": { "type": "string", "format": "sha256" }
  }
}
