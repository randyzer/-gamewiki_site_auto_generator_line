{
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["PASSED", "PARTIAL", "BLOCKED", "WAITING_FOR_USER", "FAILED"] },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "stage4_completion": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string", "const": "STAGE4_WORKER_HANDOFF_V1" },
        "worker_owned_gates": { "type": "string", "const": "PASSED" },
        "host_validation": { "type": "string", "const": "REQUIRED" },
        "blocking_gaps": { "type": "array", "items": { "type": "string" }, "maxItems": 0 }
      },
      "required": ["kind", "worker_owned_gates", "host_validation", "blocking_gaps"],
      "additionalProperties": false
    },
    "artifacts": { "type": "array", "items": {
      "type": "object", "properties": {"kind": {"type": "string"}, "path": {"type": "string"}},
      "required": ["kind", "path"], "additionalProperties": false
    } }
  },
  "required": ["status", "summary", "evidence", "missing_inputs", "stage4_completion", "artifacts"],
  "additionalProperties": false
}
