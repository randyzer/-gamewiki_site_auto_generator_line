{
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["PASSED", "PARTIAL", "BLOCKED", "WAITING_FOR_USER", "FAILED"] },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "stage4_completion": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string", "const": "STAGE4_WORKER_HANDOFF_V1" },
        "worker_owned_gates": { "type": "string", "const": "PASSED" },
        "host_validation": { "type": "string", "const": "REQUIRED" },
        "blocking_gaps": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "launch_blockers": { "type": "array", "items": { "type": "string", "enum": [
          "OPERATOR_IDENTITY_REQUIRED",
          "CONTACT_CHANNEL_REQUIRED",
          "JURISDICTION_REQUIRED",
          "PRIVACY_POLICY_REVIEW_REQUIRED",
          "TERMS_POLICY_REVIEW_REQUIRED",
          "DNS_DELEGATION_REQUIRED"
        ] }, "maxItems": 6 }
      },
      "required": ["kind", "worker_owned_gates", "host_validation", "blocking_gaps", "launch_blockers"],
      "additionalProperties": false
    },
    "stage5_completion": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string", "const": "STAGE5_AUDIT_HANDOFF_V1" },
        "audit_execution": { "type": "string", "const": "COMPLETE" },
        "host_validation": { "type": "string", "const": "REQUIRED" },
        "site_verdict": { "type": "string", "enum": ["SHIP", "SHIP_WITH_FIXES", "NEEDS_WORK", "BLOCKED"] }
      },
      "required": ["kind", "audit_execution", "host_validation", "site_verdict"],
      "additionalProperties": false
    },
    "stage6_completion": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string", "const": "STAGE6_PRELAUNCH_HANDOFF_V1" },
        "audit_execution": { "type": "string", "const": "COMPLETE" },
        "host_validation": { "type": "string", "const": "REQUIRED" },
        "site_disposition": { "type": "string", "enum": ["可以上线", "可以上线，但有P2待办", "暂不建议上线"] },
        "launch_readiness": { "type": "string", "enum": ["CLEARED", "NOT_CLEARED"] }
      },
      "required": ["kind", "audit_execution", "host_validation", "site_disposition", "launch_readiness"],
      "additionalProperties": false
    },
    "artifacts": { "type": "array", "items": {
      "type": "object", "properties": {"kind": {"type": "string"}, "path": {"type": "string"}},
      "required": ["kind", "path"], "additionalProperties": false
    } }
  },
  "required": ["status", "summary", "evidence", "missing_inputs", "stage4_completion", "stage5_completion", "stage6_completion", "artifacts"],
  "additionalProperties": false
}
