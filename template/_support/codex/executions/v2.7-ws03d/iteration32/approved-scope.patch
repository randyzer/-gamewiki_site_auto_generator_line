+import { describe, expect, it } from "vitest";
+import { pageInventory } from "../src/core/site-data";
+import { pageInventoryEntrySchema } from "../src/data/schemas/page-inventory";
+
+const page = { ...pageInventory.find(entry => entry.pageId === "guide.getting-started")!, publishedAt: "2026-08-10", updatedAt: "2026-09-20", sources: [
+  { sourceUrl: "https://example.com/qa-source-a", sourceType: "editorial" as const, accessedAt: "2026-09-18", evidenceNote: "Private synthetic source A evidence" },
+  { sourceUrl: "https://example.com/qa-source-b", sourceType: "editorial" as const, accessedAt: "2026-09-21", evidenceNote: "Private synthetic source B evidence" },
+] };
+const live = { state: "observed-live", observedAt: "2026-09-22", sourceUrl: "https://example.com/qa-live-status", evidenceNote: "PRIVATE_SYNTHETIC_LIVE_EVIDENCE" };
+async function resolve(input: unknown, context?: { kind: "patch" | "version"; value: string }) {
+  const module = await import("../src/core/freshness");
+  return module.resolvePageFreshness(input as Parameters<typeof module.resolvePageFreshness>[0], context);
+}
+
+describe("distinct freshness facts", () => {
+  it("accepts explicitly evidenced observed-live status", () => {
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: live }).success).toBe(true);
+  });
+  it("accepts not-live as a non-telemetry declaration without live observation fields", () => {
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: { state: "not-live" } }).success).toBe(true);
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: { state: "not-live", observedAt: "2026-09-22" } }).success).toBe(false);
+  });
+  it.each(["observedAt", "sourceUrl", "evidenceNote"])("rejects observed-live missing its %s evidence", key => {
+    const incomplete = { ...live } as Record<string, unknown>;
+    delete incomplete[key];
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: incomplete }).success).toBe(false);
+  });
+  it("rejects HTTP live-status source and unknown state/fields", () => {
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: { ...live, sourceUrl: "http://example.com/status" } }).success).toBe(false);
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: { ...live, state: "live-now" } }).success).toBe(false);
+    expect(pageInventoryEntrySchema.safeParse({ ...page, liveStatus: { ...live, telemetry: true } }).success).toBe(false);
+  });
+  it("rejects editorial update before publication without swapping dates", () => {
+    expect(pageInventoryEntrySchema.safeParse({ ...page, updatedAt: "2026-08-01" }).success).toBe(false);
+    expect(pageInventoryEntrySchema.safeParse({ ...page, updatedAt: page.publishedAt }).success).toBe(true);
+    expect(pageInventoryEntrySchema.safeParse(page).success).toBe(true);
+  });
+  it("keeps publication/update/source access/live observation and patch context distinct", async () => {
+    expect(await resolve({ ...page, liveStatus: live }, { kind: "patch", value: "4.2" })).toEqual({ publishedAt: "2026-08-10", updatedAt: "2026-09-20", sourceCheckedAt: "2026-09-21", versionContext: { kind: "patch", value: "4.2" }, liveStatus: { state: "observed-live", observedAt: "2026-09-22", sourceUrl: "https://example.com/qa-live-status" } });
+  });
+  it("does not infer live state or version from existing dates", async () => {
+    expect(await resolve(page)).toEqual({ publishedAt: "2026-08-10", updatedAt: "2026-09-20", sourceCheckedAt: "2026-09-21" });
+    expect(await resolve({ ...page, liveStatus: { state: "not-live" } }, { kind: "version", value: "Reference edition A" })).toEqual({ publishedAt: "2026-08-10", updatedAt: "2026-09-20", sourceCheckedAt: "2026-09-21", versionContext: { kind: "version", value: "Reference edition A" }, liveStatus: { state: "not-live" } });
+  });
+  it("returns the latest source access date without mutating source order or leaking notes", async () => {
+    const module = await import("../src/core/freshness");
+    const sources = [...page.sources].reverse();
+    const before = JSON.stringify(sources);
+    expect(module.latestSourceAccessedAt(sources)).toBe("2026-09-21");
+    expect(module.latestSourceAccessedAt([])).toBeUndefined();
+    expect(JSON.stringify(sources)).toBe(before);
+    expect(JSON.stringify(await resolve({ ...page, liveStatus: live }))).not.toMatch(/evidenceNote|PRIVATE_SYNTHETIC|Private synthetic/);
+  });
+});
