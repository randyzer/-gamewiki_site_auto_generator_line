+    `Focus is hidden: ${JSON.stringify(value)}`);
+  requireCondition(value.outline !== "none" && value.width > 0 && value.color !== "rgba(0, 0, 0, 0)", `No machine-detectable outline: ${JSON.stringify(value)}`);
